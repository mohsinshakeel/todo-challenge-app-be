{
  "printWidth": 120,
  "tabWidth": 2,
  "singleQuote": true,
  "semi": true,
  "trailingComma": "all",
  "importOrderMergeDuplicateImports": true,
  "importOrderSortIndividualImports": true,
  "importOrderTypeImportsToTop": true,
  "importOrderCaseInsensitive": true,
  "prettier/prettier": [{ "endOfLine": "auto" }]
}
