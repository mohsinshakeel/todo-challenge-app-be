datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum TaskStatus {
  PENDING
  COMPLETED
}

model Tasks {
  id        String    @id @default(uuid()) @db.Char(36)
  title     String
  color     String
  status    TaskStatus
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}
